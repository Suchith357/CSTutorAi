# OSTutorAI environment template
# Copy to .env and adjust as needed.

APP_NAME=OSTutorAI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# --- Security / authentication ---
# Auth secret used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be overridden in any real deployment; the app refuses to start with
# the development default when ENVIRONMENT != development.
AUTH_SECRET_KEY=dev-insecure-secret-change-me-4f2b8c1a9d7e3f6b0a5c8d2e1f4b7a9c
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
# bcrypt work factor (cost). Higher = slower hashes = better brute-force
# resistance. Keep 12 in development; use 12-14 in production depending on
# acceptable login latency.
AUTH_BCRYPT_ROUNDS=12

# --- Rate limiting (login brute-force protection) ---
# Failed login attempts allowed per identity+IP inside the window; identity is
# locked for the cooldown period afterwards.
AUTH_RATE_LIMIT_MAX_FAILURES=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_COOLDOWN_SECONDS=600

# --- Retrieval / RAG ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=3

# --- Grounding / relevance control ---
# Minimum cosine similarity for the top retrieved chunk. Scores are NOT
# percentages or probabilities: they are cosine similarities in [-1, 1]
# computed from normalized embeddings (FAISS inner product). This default is
# an engineering starting point for the current toy corpus; it must be
# calibrated later using a labeled evaluation dataset. Questions whose best
# retrieval score falls below this value receive a safe insufficient-context
# response and never reach the LLM.
RETRIEVAL_MIN_SCORE=0.42

# --- Data / index locations ---
RAW_DATA_DIR=data/raw
INDEX_DIR=data/index

# --- LLM (local and free; no API keys required) ---
# provider: "transformers" (local HF model) or "mock" (offline/testing)
LLM_PROVIDER=transformers
LLM_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
LLM_MAX_NEW_TOKENS=256
