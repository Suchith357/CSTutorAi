# OSTutorAI environment template
# Copy to .env and adjust as needed.

APP_NAME=OSTutorAI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# --- Security / authentication ---
# Auth secret used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be overridden in any real deployment; the app refuses to start with
# the development default when ENVIRONMENT != development.
AUTH_SECRET_KEY=dev-insecure-secret-change-me-4f2b8c1a9d7e3f6b0a5c8d2e1f4b7a9c
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
# bcrypt work factor (cost). Higher = slower hashes = better brute-force
# resistance. Keep 12 in development; use 12-14 in production depending on
# acceptable login latency.
AUTH_BCRYPT_ROUNDS=12

# --- Rate limiting (login brute-force protection) ---
# Failed login attempts allowed per identity+IP inside the window; identity is
# locked for the cooldown period afterwards.
AUTH_RATE_LIMIT_MAX_FAILURES=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_COOLDOWN_SECONDS=600

# --- Retrieval / RAG ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=3

# --- Grounding / relevance control ---
# Minimum cosine similarity for the top retrieved chunk. Scores are NOT
# percentages or probabilities: they are cosine similarities in [-1, 1]
# computed from normalized embeddings (FAISS inner product). This default is
# an engineering starting point for the current toy corpus; it must be
# calibrated later using a labeled evaluation dataset. Questions whose best
# retrieval score falls below this value receive a safe insufficient-context
# response and never reach the LLM.
RETRIEVAL_MIN_SCORE=0.42

# --- Tutor Engine / adaptive teaching ---
# Mastery update rule (clamped to [0,1]): correct answers add
# TUTOR_MASTERY_GAIN_CORRECT, incorrect ones subtract
# TUTOR_MASTERY_DROP_INCORRECT. Hint usage is tracked but never scored.
TUTOR_MASTERY_GAIN_CORRECT=0.10
TUTOR_MASTERY_DROP_INCORRECT=0.05
TUTOR_MASTERY_GAIN_HINT=0.0
# Difficulty scale 1..5 (beginner..exam). Thresholds map mastery to difficulty.
TUTOR_DIFFICULTY_LOW_THRESHOLD=0.25
TUTOR_DIFFICULTY_MEDIUM_THRESHOLD=0.45
TUTOR_DIFFICULTY_HIGH_THRESHOLD=0.70
TUTOR_DIFFICULTY_EXAM_THRESHOLD=0.90
TUTOR_RECENT_PERFORMANCE_LIMIT=10
TUTOR_DEFAULT_STUDENT_ID=demo
# Max tokens for generated tutoring responses (teaching needs more room than QA).
TUTOR_MAX_NEW_TOKENS=512

# --- Data / index locations ---
RAW_DATA_DIR=data/raw
INDEX_DIR=data/index

# --- LLM (local and free; no API keys required) ---
# provider: "transformers" (local HF model) or "mock" (offline/testing)
LLM_PROVIDER=transformers
# Qwen2.5-3B-Instruct gives much better teaching quality than 0.5B.
# Loading strategy (LLM_DEVICE=auto, default):
#   - CUDA + bitsandbytes available -> 4-bit NF4 quantized on GPU (~2-3 GB
#     VRAM; the 3B model does NOT fit 6 GB VRAM in fp32/fp16)
#   - otherwise -> CPU float32 fallback (never crashes)
LLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
# auto (recommended) | cuda | cpu
LLM_DEVICE=auto
# auto: bfloat16 compute on GPU (4-bit), float32 on CPU
LLM_TORCH_DTYPE=auto
# 4-bit quantization (bitsandbytes NF4), used when CUDA is available
LLM_LOAD_IN_4BIT=true
LLM_4BIT_QUANT_TYPE=nf4
LLM_MAX_NEW_TOKENS=256
# Lower generation cap for beginner difficulty (1-2): bounds runaway output;
# prompt-level conciseness constraints do the real work.
# TUTOR_MAX_NEW_TOKENS_BEGINNER=320
